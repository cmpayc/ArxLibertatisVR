
# Compile HLSL shaders to SPIR-V headers with dxc for the Vulkan renderer
#
# The Direct3D 11 shader source in src/graphics/d3d11/D3D11Shaders.h is the only copy of the shaders.
# It is extracted into .hlsl files and each entry point is compiled into a header with a byte array.
#
# Direct3D 11 has separate resource slots for each shader stage. They are mapped to Vulkan bindings in descriptor
# set 0 as <stage base> + <register type offset> + <register>:
#   stage base: vs 0, ps 64, hs 128, ds 192
#   register type offset: b (constant buffers) 0, t (textures) 16, s (samplers) 48
# Constant buffers keep the Direct3D packing rules (-fvk-use-dx-layout), so the C++ structures can be shared.

set(SPIRV_SHADER_DIR "${CMAKE_CURRENT_BINARY_DIR}/shaders/spirv")
set(SPIRV_SHADER_HEADERS)
set(SPIRV_SHADER_NAMES)

set(_hlsl_header "${CMAKE_CURRENT_SOURCE_DIR}/src/graphics/d3d11/D3D11Shaders.h")
set(_hlsl_script "${CMAKE_CURRENT_LIST_DIR}/ExtractHLSL.cmake")

# Extract HLSL source code from D3D11Shaders.h
# SOURCE is the name of the .hlsl file, the remaining arguments are the arrays it contains
function(spirv_hlsl_source SOURCE)
	set(output "${SPIRV_SHADER_DIR}/${SOURCE}")
	add_custom_command(
		OUTPUT "${output}"
		COMMAND ${CMAKE_COMMAND} "-DINPUT=${_hlsl_header}" "-DOUTPUT=${output}" "-DARRAYS=${ARGN}"
		        -P "${_hlsl_script}"
		DEPENDS "${_hlsl_header}" "${_hlsl_script}"
		COMMENT "Extracting HLSL ${SOURCE}"
		VERBATIM
	)
endfunction()

# Compile one entry point to ${SPIRV_SHADER_DIR}/<NAME>.h with the array spirv_<NAME>
# PROFILE is a shader model 6 profile such as vs_6_0, the remaining arguments are preprocessor definitions
function(spirv_shader NAME SOURCE ENTRY PROFILE)

	string(SUBSTRING "${PROFILE}" 0 2 stage)
	if(stage STREQUAL "vs")
		set(base 0)
	elseif(stage STREQUAL "ps")
		set(base 64)
	elseif(stage STREQUAL "hs")
		set(base 128)
	elseif(stage STREQUAL "ds")
		set(base 192)
	else()
		message(FATAL_ERROR "Unsupported shader profile ${PROFILE}")
	endif()
	math(EXPR t_shift "${base} + 16")
	math(EXPR s_shift "${base} + 48")

	set(defines)
	foreach(define IN LISTS ARGN)
		list(APPEND defines -D "${define}")
	endforeach()

	set(input "${SPIRV_SHADER_DIR}/${SOURCE}")
	set(output "${SPIRV_SHADER_DIR}/${NAME}.h")
	add_custom_command(
		OUTPUT "${output}"
		COMMAND "${DXC_EXECUTABLE}" -nologo -spirv -HV 2018 -fspv-target-env=vulkan1.1 -fvk-use-dx-layout
		        -fvk-b-shift ${base} 0 -fvk-t-shift ${t_shift} 0 -fvk-s-shift ${s_shift} 0
		        -O3 -T ${PROFILE} -E ${ENTRY} ${defines} -Vn spirv_${NAME} -Fh "${output}" "${input}"
		DEPENDS "${input}"
		COMMENT "Compiling SPIR-V shader ${NAME}"
		VERBATIM
	)

	set(SPIRV_SHADER_HEADERS ${SPIRV_SHADER_HEADERS} "${output}" PARENT_SCOPE)
	set(SPIRV_SHADER_NAMES ${SPIRV_SHADER_NAMES} ${NAME} PARENT_SCOPE)

endfunction()

# Write ${SPIRV_SHADER_DIR}/VulkanShaderCode.h including all compiled shaders
# and add the target vulkan-shaders that builds them
function(spirv_shader_target)

	set(code "// Generated by cmake/SPIRVShaders.cmake\n\n")
	foreach(name IN LISTS SPIRV_SHADER_NAMES)
		string(APPEND code "#include \"${name}.h\"\n")
	endforeach()

	set(output "${SPIRV_SHADER_DIR}/VulkanShaderCode.h")
	if(EXISTS "${output}")
		file(READ "${output}" old_code)
	endif()
	if(NOT old_code STREQUAL code)
		file(WRITE "${output}" "${code}")
	endif()

	add_custom_target(vulkan-shaders DEPENDS ${SPIRV_SHADER_HEADERS})

endfunction()
